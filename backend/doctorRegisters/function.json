{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "post"
      ]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "cosmosDB",
      "direction": "out",
      "name": "doctorDocument",
      "databaseName": "Medibook",
      "containerName": "doctors",
      "connection": "COSMOS_CONNECTION_STRING",
      "createIfNotExists": false
    }
  ]
}